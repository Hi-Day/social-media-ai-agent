NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is also supported for existing Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=SocialOS

# LinkedIn OAuth (server-side only)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Base64 of 32 random bytes; generate with: openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Optional YYYYMM API version accepted by LinkedIn
LINKEDIN_API_VERSION=202601

# Instagram Login API (server-side only)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Exact callback URL: https://<your-domain>/api/integrations/instagram/callback
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_GRAPH_API_VERSION=v26.0

# TikTok OAuth (server-side only)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Exact callback URL: https://<your-domain>/api/integrations/tiktok/callback
TIKTOK_REDIRECT_URI=

# Server-only Supabase service role key. Never prefix with NEXT_PUBLIC_ or expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Xendit Subscription API (server-side only; do not expose to browser)
XENDIT_SECRET_API_KEY=
XENDIT_WEBHOOK_TOKEN=
# Configure only after pricing and included monthly credits are approved.
SOCIALOS_STARTER_PRICE_IDR=
SOCIALOS_STARTER_MONTHLY_CREDITS=
SOCIALOS_GROWTH_PRICE_IDR=
SOCIALOS_GROWTH_MONTHLY_CREDITS=
SOCIALOS_AGENCY_PRICE_IDR=
SOCIALOS_AGENCY_MONTHLY_CREDITS=
# Set true only after sandbox checkout, webhooks, pricing and entitlements are verified.
BILLING_ENFORCEMENT_ENABLED=false
